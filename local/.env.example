# Copy to local/.env and fill in. Never commit local/.env.
# The Anypoint CLI v4 reads ANYPOINT_CLIENT_ID / ANYPOINT_CLIENT_SECRET / ANYPOINT_ORG
# directly. Connected App needs API Manager scopes:
#   "View APIs Configuration", "Manage APIs Configuration", "Manage Policies"
ANYPOINT_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANYPOINT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Business group / org (name or id).
ANYPOINT_ORG=My Business Group

# Map logical env names used in config/<env>/ to real Anypoint environment names.
APIM_ENV_MAP={"test":"Test","uat":"UAT","preprod":"Pre-Prod","prod":"Production"}

# EU control plane? uncomment:
# ANYPOINT_HOST=eu1.anypoint.mulesoft.com

# Which logical env is first in the promotion chain (extract target). Default: dev
APIM_INITIAL_ENV=test

# Override the CLI executable (default: anypoint-cli-v4 on PATH)
# ANYPOINT_CLI=anypoint-cli-v4
